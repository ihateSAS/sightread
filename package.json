{
  "name": "sightread",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Ask a codebase what a change breaks. It answers with the parsed import graph and without it, then counts the gap.",
  "scripts": {
    "start": "node app/server.mjs",
    "start:gateway": "SIGHTREAD_TRANSPORT=gateway node app/server.mjs",
    "take:kimi": "SIGHTREAD_FIRST_TOKEN_BUDGET_MS=12000 CEREBRAS_RACE_MODEL=moonshotai-kimi-k3.1-pro-trial OPENROUTER_RACE_MODEL=moonshotai/kimi-k3.1-pro node app/server.mjs",
    "take:fallback": "CEREBRAS_RACE_MODEL=qwen-3.8-27b OPENROUTER_RACE_MODEL=qwen/qwen3.8-27b node app/server.mjs",
    "race": "node race/server.mjs",
    "check": "bash ./check-cerebras.sh",
    "test": "node --test test/*.test.mjs",
    "gateway": "set -a; . ./.env 2>/dev/null; set +a; exec openclaw gateway run"
  }
}
