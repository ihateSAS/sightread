{
  agents: {
    entries: {
      // A minimal agent for the Sightread demo: no skills, tools denied. The
      // graph already carries the evidence, so an answer takes one or two model
      // calls instead of the four or five an exploring agent spent. That matters
      // because the free Cerebras tier allows five requests a minute, and a pair
      // of exploring answers could not fit inside one minute.
      //
      // The repo-read skill is out for the same reason: it tells the model to
      // read before answering, which it does not need to do here.
      sightread: {
        workspace: "/Users/djh/Desktop/home/kimi-hackathon",
        // ACP has no per-session model override: the bridge runs the agent's
        // configured chain, so this is what actually answers. Kimi is primary
        // and qwen is the fallback, which means capacity landing needs no edit
        // here: the first successful Kimi call takes over automatically.
        model: {
          primary: "cerebras/kimi-k3.1-pro",
          fallbacks: ["cerebras/qwen-3.8-27b", "cerebras/gpt-oss-120b"],
        },
        skills: [],
        contextInjection: "never",
        tools: {
          deny: ["*"],
        },
      },
    },
  },
}
