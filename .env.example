# Copy to .env and fill in. .env is gitignored; this template is not.
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=

# The sightread agent runs Kimi K3.1 Pro as primary and qwen-3.8-27b as its
# fallback (see openclaw/sightread-agent.patch.json5), so Kimi capacity landing
# needs no code change. To swap in a new key: replace CEREBRAS_API_KEY above,
# then restart both processes, because each reads this file at boot:
#   npm run gateway
#   npm start

# Optional
# SIGHTREAD_MODEL=cerebras/moonshotai-kimi-k3.1-pro-trial
# What the page names while the primary is missing from the provider's model
# list. Defaults to qwen.
# SIGHTREAD_FALLBACK_MODEL=cerebras/qwen-3.8-27b
# PORT=8787

# exec    = cold process per question (isolated, ~4.5s of start-up)
# gateway = reuse a running `npm run gateway` (measured 14-22s stuck in the
#           gateway session store; only for the CLI/gateway fallback path)
# auto    = use gateway when reachable, otherwise fall back to exec (default)
# Leave unset for the demo: with CEREBRAS_API_KEY set, Ask streams straight
# from Cerebras and none of these transports is on the recording path.
# SIGHTREAD_TRANSPORT=auto

# Speed Race tab (same server as Ask, on :8787; the standalone
# node race/server.mjs on :8788 reads the same two variables)
# Keep both lanes on the same model: the race is only honest that way.
# Current verified pair (Nov 2026 run). Same model on both lanes, which is the
# only fair provider comparison: Kimi K3.1 Pro on each side.
# CEREBRAS_RACE_MODEL=moonshotai-kimi-k3.1-pro-trial
# OPENROUTER_RACE_MODEL=moonshotai/kimi-k3.1-pro
# For a fallback take (Kimi trial queue is long), race the qwen pair instead so
# both lanes still share a model:
# CEREBRAS_RACE_MODEL=qwen-3.8-27b
# OPENROUTER_RACE_MODEL=qwen/qwen3.8-27b
